  "beats": [
    {
      "id": "scan",
      "title": "Code grades what code can",
      "plain": "A script reads the plugin and scores, from 0 to 4, every check a fixed rule can settle: links, paths, the manifest, file sizes.",
      "technical": "runScan() walks the tree; mechanicalGrades() sets SQ7, SQ8, CS3, CS7, AN2, CF1, MH3 and the rest to 0-4.",
      "focus": [
        "target",
        "scanner",
        "mcheck"
      ],
      "flows": [
        "scan",
        "mgrade"
      ],
      "ms": 3800
    },
    {
      "id": "grade",
      "title": "The model grades the rest",
      "plain": "The model scores the checks that need judgment, 0 to 4, and must back each with a file and a quote. That is all it decides.",
      "technical": "evaluate-plugin Step 3: every applicable_judgment_check gets {check, grade, evidence} in grades.json, SQ1-SQ6 once per skill.",
      "focus": [
        "grader",
        "jcheck"
      ],
      "flows": [
        "read",
        "jgrade"
      ],
      "ms": 4400
    },
    {
      "id": "fold",
      "title": "Grades fold into dimensions",
      "plain": "From here on it is all the script. Each row of grades becomes one score for its area, counting heavier checks for more.",
      "technical": "runScore(): points = grade * 25, per-skill entries averaged, then score = sum(points * weight) / sum(weight) for each dimension.",
      "focus": [
        "mcheck",
        "jcheck",
        "dims"
      ],
      "flows": [
        "foldm",
        "foldj"
      ],
      "ms": 4200
    },
    {
      "id": "weigh",
      "title": "Six into one",
      "plain": "Each dimension adds its score times its weight. One that does not apply drops out, and the others scale up to fill its share.",
      "technical": "composite = sum(score * weight) / totalW over applicable dimensions; WQ is N/A with no workflows, so totalW is 90 and SQ counts 33.3%.",
      "focus": [
        "dims",
        "composite"
      ],
      "flows": [
        "weigh"
      ],
      "ms": 4400
    },
    {
      "id": "verdict",
      "title": "The composite lands in a band",
      "plain": "The composite lands in a band: 85 and up is adopt, 70 to 85 adopt with fixes, 50 to 70 rework, below that avoid.",
      "technical": "tierFor(composite) against VERDICT_TIERS 85/70/50; a gate from computeGates() or a finding would then cap it via worstTier(). None is drawn here.",
      "focus": [
        "composite",
        "verdict"
      ],
      "flows": [
        "tier"
      ],
      "ms": 4200
    },
    {
      "id": "rank",
      "title": "What each fix buys",
      "plain": "The script re-scores once for each weak check as if it scored 4, and ranks the gains. The top one is the fix to make first.",
      "technical": "computeFixDeltas(): each check under 4 raised to 4 in a clone, runScore() again, sorted by delta; a tie keeps judgment checks first.",
      "focus": [
        "composite",
        "fixdeltas"
      ],
      "flows": [
        "rescore"
      ],
      "ms": 4400
    },
    {
      "id": "rest",
      "rest": true,
      "focus": [],
      "flows": [],
      "ms": 1600
    }
  ],

    {
      "id": "change",
      "title": "Make one change",
      "plain": "One focused change is made: a god-file split, or one shallow module deepened.",
      "technical": "applyMemberOnRoot calls cfg.implPrompt; the implementer extracts one cluster behind compat shims.",
      "focus": [
        "change"
      ],
      "flows": [
        "edit"
      ],
      "ms": 3000
    },
    {
      "id": "check",
      "title": "Only new reds count",
      "plain": "The tests run again. A failure on the already-red list is crossed off; only the ones left over count against the change.",
      "technical": "validatePrompt gets ROUND_RED; a test is a regression only if it fails now and is not in the oracle, reported as new_failures.",
      "focus": [
        "check",
        "oracle"
      ],
      "flows": [
        "submit",
        "subtract"
      ],
      "ms": 4200
    },
    {
      "id": "repair",
      "title": "Fix forward first",
      "plain": "Each new failure goes back to be fixed in place, and the tests run again after every repair: here two repairs clear both.",
      "technical": "While passed is not true and repairs < MAX_REPAIRS (3), repairPrompt gets new_failures, then validateWithRetry runs again.",
      "focus": [
        "repair",
        "change"
      ],
      "flows": [
        "sendback",
        "fix"
      ],
      "ms": 4800
    },
    {
      "id": "land",
      "title": "Green lands",
      "plain": "With no new failures left, the change is committed, and that commit is the HEAD the next round starts from.",
      "technical": "val.passed === true: cfg.commitPrompt commits; the next round's oracle records the new HEAD as its ROUND_BASE.",
      "focus": [
        "branch"
      ],
      "flows": [
        "land"
      ],
      "ms": 3200
    },
    {
      "id": "putback",
      "title": "Still red: put back",
      "plain": "The next change still breaks one test after all three repairs, so it is undone, back to the HEAD that round began from.",
      "technical": "Repairs exhausted: safeRevertPrompt soft-resets to ROUND_BASE and checks out tracked files. Nothing is committed; git clean is banned.",
      "focus": [
        "base"
      ],
      "flows": [
        "putback"
      ],
      "ms": 4200
    },

    {
      "id": "oracle",
      "title": "Note what is already red",
      "plain": "Before touching anything, the round runs the tests on the clean starting point, HEAD, and writes down which already fail.",
      "technical": "The oracle agent runs TEST_CMD(VAL_PATHS) on the clean tree; ROUND_RED joins BASELINE_RED and its red_tests, ROUND_BASE is HEAD.",
      "focus": [
        "base",
        "oracle"
      ],
      "flows": [
        "snapshot"

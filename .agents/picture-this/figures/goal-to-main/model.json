      "id": "grill",
      "title": "A goal, questioned",
      "plain": "A goal too big for one change is questioned one answer at a time, then written down as a spec and a plan of issues.",
      "technical": "but-first-planning grill, spec-write and plan-decompose leave the spec and its issues under .agents/plan/.",
      "focus": [
        "but-first-planning"
      ],
      "flows": [],
      "ms": 3000
